# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). Both of these are safe
# to expose to the browser — access control is enforced by the Row Level
# Security policies in supabase/schema.sql, not by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never prefix these with NEXT_PUBLIC_. Used by the daily
# cleanup job that deletes leave attachments 30 days after upload
# (app/api/cron/purge-leave-attachments, scheduled in vercel.json).
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API > service_role (secret) key.
# CRON_SECRET: any long random string; Vercel sends it with each cron call.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
